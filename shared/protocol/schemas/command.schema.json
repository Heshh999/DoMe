{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dome.app/schemas/command.schema.json",
  "title": "DoMe signed command payload",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "protocol_version",
    "command_id",
    "account_id",
    "controller_id",
    "target_pc_id",
    "action",
    "params",
    "target",
    "issued_at",
    "expires_at",
    "nonce"
  ],
  "properties": {
    "type": {
      "const": "command"
    },
    "protocol_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "command_id": {
      "$ref": "#/$defs/uuid"
    },
    "account_id": {
      "$ref": "#/$defs/uuid"
    },
    "controller_id": {
      "$ref": "#/$defs/uuid"
    },
    "target_pc_id": {
      "$ref": "#/$defs/uuid"
    },
    "action": {
      "type": "string",
      "pattern": "^[a-z]+\\.[a-z_]+$",
      "maxLength": 64
    },
    "params": {
      "type": "object",
      "description": "Validated against actions.json[action].params by the PC"
    },
    "target": {
      "description": "Validated against actions.json[action].target schema by the PC; null when the action takes no target",
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object"
        }
      ]
    },
    "origin": {
      "description": "Optional. Present when the command is one step of a Pro routine; the PC refuses steps whose action is not routine_allowed and applies the entitlement assertion. Absent for manual controls and typed commands.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "routine_id",
        "step"
      ],
      "properties": {
        "kind": {
          "const": "routine"
        },
        "routine_id": {
          "$ref": "#/$defs/uuid"
        },
        "step": {
          "type": "integer",
          "minimum": 0,
          "maximum": 31
        }
      }
    },
    "issued_at": {
      "$ref": "#/$defs/timestamp"
    },
    "expires_at": {
      "$ref": "#/$defs/timestamp"
    },
    "nonce": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{22}$",
      "description": "base64url of 16 random bytes"
    }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,3})?Z$",
      "description": "RFC 3339 UTC with optional milliseconds"
    }
  }
}
