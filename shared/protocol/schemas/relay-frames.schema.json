{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dome.app/schemas/relay-frames.schema.json",
  "title": "DoMe relay WebSocket frames",
  "description": "All frames are JSON objects with a `type`. Frames are limited to 65536 bytes. Unknown `type` or unknown fields are rejected with MALFORMED_MESSAGE and the socket may be closed. The relay never alters a signed envelope or a challenge_text; it adds routing metadata in sibling fields which receivers treat as informational only. Terminal-result rule: every command_id a controller sends ends with exactly one `result` frame (see version.json rules.terminal_result); `error` frames are for situations with no command_id. Close codes: 1009 frame too large; 4000 protocol error; 4001 superseded by another connection of the same PC (the agent must NOT auto-reconnect; it shows a tray warning with a manual Reconnect); 4003 revoked/unauthorised; 4008 authentication required.",
  "$defs": {
    "uuid": {
      "$ref": "command.schema.json#/$defs/uuid"
    },
    "timestamp": {
      "$ref": "command.schema.json#/$defs/timestamp"
    },
    "envelope": {
      "$ref": "envelope.schema.json"
    },
    "lifecycle_state": {
      "type": "string",
      "enum": [
        "created",
        "awaiting_confirmation",
        "accepted",
        "executing",
        "succeeded",
        "failed",
        "expired",
        "canceled",
        "outcome_unknown"
      ]
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message",
        "retryable"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[A-Z_]+$",
          "maxLength": 64
        },
        "message": {
          "type": "string",
          "maxLength": 512
        },
        "retryable": {
          "type": "boolean"
        },
        "detail": {
          "type": "object"
        }
      }
    },
    "pc_connection_state": {
      "type": "string",
      "enum": [
        "online",
        "reconnecting",
        "offline"
      ]
    },
    "hello": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "component",
        "component_version",
        "protocol_versions",
        "registry_version"
      ],
      "properties": {
        "type": {
          "const": "hello"
        },
        "component": {
          "type": "string",
          "enum": [
            "controller",
            "agent",
            "relay"
          ]
        },
        "kid": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$",
          "description": "REQUIRED when component is 'controller': the installation's controller key id. The relay binds the socket to the controller row (session account, kid); every envelope on this socket must carry the same kid."
        },
        "proof": {
          "$ref": "#/$defs/envelope",
          "description": "Controller sockets only. An ES256 envelope signed by the key named by `kid` whose payload is a `hello_proof` (#/$defs/hello_proof). The relay binds the socket to the controller row only after verifying it; a hello without a valid proof stays unbound (hello_ack without controller_id). Agents never send it (they authenticate with the PC access token)."
        },
        "component_version": {
          "type": "string",
          "maxLength": 64
        },
        "protocol_versions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+$"
          }
        },
        "registry_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+$"
        },
        "capabilities": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "string",
            "maxLength": 32
          }
        }
      },
      "description": "First frame on every socket. Controller sockets MUST include kid (bound to the session's account); agent sockets are identified by their bearer token."
    },
    "hello_ack": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "protocol_version",
        "server_time",
        "connection_id"
      ],
      "properties": {
        "type": {
          "const": "hello_ack"
        },
        "protocol_version": {
          "type": "string"
        },
        "server_time": {
          "$ref": "#/$defs/timestamp"
        },
        "connection_id": {
          "$ref": "#/$defs/uuid"
        },
        "controller_id": {
          "$ref": "#/$defs/uuid"
        },
        "pc_id": {
          "$ref": "#/$defs/uuid"
        }
      },
      "description": "controller_id is present on controller sockets whose kid matched a non-revoked controller of the account; a socket without controller_id may only be used to poll pairing status via REST, never for subscribe/command/confirmation/cancel (those answer error GRANT_MISSING). pc_id is present on agent sockets and must equal the agent's stored identity."
    },
    "error_frame": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "error"
      ],
      "properties": {
        "type": {
          "const": "error"
        },
        "error": {
          "$ref": "#/$defs/error"
        },
        "ref_pc_id": {
          "$ref": "#/$defs/uuid",
          "description": "Required for subscription errors so the controller knows which PC was refused"
        }
      },
      "description": "Relay or agent → peer. Used only when no command_id can be associated (malformed frame, protocol incompatibility, subscription errors). Command-scoped failures are always `result` frames."
    },
    "ping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "const": "ping"
        },
        "t": {
          "$ref": "#/$defs/timestamp"
        }
      }
    },
    "pong": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "const": "pong"
        },
        "t": {
          "$ref": "#/$defs/timestamp"
        }
      }
    },
    "controller_subscribe": {
      "description": "Controller → relay. Idempotent; REPLACES the socket's subscription set (subscriptions never survive a socket). Each pc_id must be a PC of the session's account on which THIS controller (bound at hello) holds a live grant; otherwise error{GRANT_MISSING, ref_pc_id} for that id and no subscription. For each accepted id the relay sends pc_status and then the cached last `state` frame of that PC (unchanged, with its original `at`) when one exists.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "pc_ids"
      ],
      "properties": {
        "type": {
          "const": "subscribe"
        },
        "pc_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/uuid"
          }
        }
      }
    },
    "controller_command": {
      "description": "Controller → relay. The relay verifies the envelope signature against the controller's registered key, checks the payload's account/controller/target ownership and grant, enforces rate limits and queue depth, then forwards to the PC. It never executes anything itself.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "pc_id",
        "envelope"
      ],
      "properties": {
        "type": {
          "const": "command"
        },
        "pc_id": {
          "$ref": "#/$defs/uuid"
        },
        "envelope": {
          "$ref": "#/$defs/envelope"
        }
      }
    },
    "controller_confirmation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "pc_id",
        "envelope"
      ],
      "properties": {
        "type": {
          "const": "confirmation"
        },
        "pc_id": {
          "$ref": "#/$defs/uuid"
        },
        "envelope": {
          "$ref": "#/$defs/envelope"
        }
      }
    },
    "controller_cancel": {
      "description": "Controller → relay → PC. Best-effort cancel of a queued or countdown command. Not signed in v1.0 because the worst case is a cancelled action; the relay checks the controller owns the command.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "pc_id",
        "command_id"
      ],
      "properties": {
        "type": {
          "const": "cancel"
        },
        "pc_id": {
          "$ref": "#/$defs/uuid"
        },
        "command_id": {
          "$ref": "#/$defs/uuid"
        }
      }
    },
    "relay_to_agent_command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "envelope",
        "relay"
      ],
      "properties": {
        "type": {
          "const": "command"
        },
        "envelope": {
          "$ref": "#/$defs/envelope"
        },
        "relay": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "received_at",
            "connection_id"
          ],
          "properties": {
            "received_at": {
              "$ref": "#/$defs/timestamp"
            },
            "connection_id": {
              "$ref": "#/$defs/uuid"
            }
          }
        }
      }
    },
    "relay_to_agent_confirmation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "envelope",
        "relay"
      ],
      "properties": {
        "type": {
          "const": "confirmation"
        },
        "envelope": {
          "$ref": "#/$defs/envelope"
        },
        "relay": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "received_at",
            "connection_id"
          ],
          "properties": {
            "received_at": {
              "$ref": "#/$defs/timestamp"
            },
            "connection_id": {
              "$ref": "#/$defs/uuid"
            }
          }
        }
      }
    },
    "relay_to_agent_cancel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "command_id",
        "controller_id"
      ],
      "properties": {
        "type": {
          "const": "cancel"
        },
        "command_id": {
          "$ref": "#/$defs/uuid"
        },
        "controller_id": {
          "$ref": "#/$defs/uuid"
        }
      }
    },
    "grants_snapshot": {
      "description": "Relay → agent, sent immediately after hello_ack and whenever grants change. The agent applies it BEFORE accepting commands after (re)connect. It is a revocation/intersection list over the PC's LOCALLY approved controllers: a controller is usable only if locally approved AND listed here; effective capabilities = local ∩ snapshot. It carries no public keys and can never add a controller or widen a grant. A listed controller_id/kid the PC does not know locally is ignored and reported as a security event. pc_enabled=false or status=plan_disabled are plan/account states, not revocations: local grants stay, commands are refused with PC_PLAN_DISABLED / CONTROLLER_PLAN_DISABLED.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "pc_id",
        "account_id",
        "snapshot_id",
        "pc_enabled",
        "controllers"
      ],
      "properties": {
        "type": {
          "const": "grants_snapshot"
        },
        "pc_id": {
          "$ref": "#/$defs/uuid"
        },
        "account_id": {
          "$ref": "#/$defs/uuid"
        },
        "snapshot_id": {
          "$ref": "#/$defs/uuid"
        },
        "pc_enabled": {
          "type": "boolean",
          "description": "False when the PC is disabled by the account or by the plan after a downgrade; the agent then refuses every command with PC_PLAN_DISABLED (local emergency controls still work)"
        },
        "controllers": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "controller_id",
              "kid",
              "capabilities",
              "display_name",
              "status"
            ],
            "properties": {
              "controller_id": {
                "$ref": "#/$defs/uuid"
              },
              "kid": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{43}$"
              },
              "capabilities": {
                "type": "array",
                "maxItems": 16,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "enum": [
                    "status",
                    "media",
                    "volume",
                    "apps",
                    "lock",
                    "power"
                  ]
                }
              },
              "display_name": {
                "type": "string",
                "maxLength": 64
              },
              "status": {
                "type": "string",
                "enum": [
                  "active",
                  "plan_disabled"
                ],
                "description": "plan_disabled keeps the LOCAL grant intact (revocation/emergency stop keep working) but the PC refuses commands with CONTROLLER_PLAN_DISABLED"
              }
            }
          }
        },
        "entitlement_assertion": {
          "type": "string",
          "description": "Compact JWS (EdDSA) or absent on Free",
          "maxLength": 4096
        }
      }
    },
    "pairing_request": {
      "description": "Relay → agent. A signed-in controller claimed this PC's pairing code (by hash). Delivered immediately when the agent is online and re-delivered, for every unexpired claimed pairing session of this PC, right after grants_snapshot on each (re)connect. The agent MUST recompute kid_from_jwk(public_jwk) and refuse on mismatch, then compute the verification code HMAC(code, pairing_id|pc_id|kid) locally and show it with controller_display_name (untrusted text) for the user to approve or decline.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "pairing_id",
        "code_hash",
        "controller_display_name",
        "public_jwk",
        "kid",
        "requested_capabilities",
        "expires_at"
      ],
      "properties": {
        "type": {
          "const": "pairing_request"
        },
        "pairing_id": {
          "$ref": "#/$defs/uuid"
        },
        "code_hash": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$",
          "description": "SHA-256 handle of the pairing code the PC is displaying; the agent ignores requests whose code_hash does not match its current pairing session"
        },
        "controller_display_name": {
          "type": "string",
          "maxLength": 64
        },
        "public_jwk": {
          "$ref": "#/$defs/ec_public_jwk"
        },
        "kid": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$"
        },
        "requested_capabilities": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "status",
              "media",
              "volume",
              "apps",
              "lock",
              "power"
            ]
          }
        },
        "expires_at": {
          "$ref": "#/$defs/timestamp"
        }
      }
    },
    "pairing_decision": {
      "description": "Agent → relay after the local approve/decline. On approve, `kid` must equal the kid the agent computed from the JWK it stored; the relay only then creates the controller/grant rows.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "pairing_id",
        "decision",
        "kid",
        "granted_capabilities"
      ],
      "properties": {
        "type": {
          "const": "pairing_decision"
        },
        "pairing_id": {
          "$ref": "#/$defs/uuid"
        },
        "decision": {
          "type": "string",
          "enum": [
            "approve",
            "decline"
          ]
        },
        "kid": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$"
        },
        "granted_capabilities": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "status",
              "media",
              "volume",
              "apps",
              "lock",
              "power"
            ]
          }
        }
      }
    },
    "agent_ack": {
      "description": "Agent → relay → controller. Delivery/authorization acknowledgement only; NOT an execution result. Never carries a terminal state.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "command_id",
        "state",
        "at"
      ],
      "properties": {
        "type": {
          "const": "ack"
        },
        "command_id": {
          "$ref": "#/$defs/uuid"
        },
        "state": {
          "type": "string",
          "enum": [
            "accepted",
            "awaiting_confirmation",
            "executing"
          ]
        },
        "at": {
          "$ref": "#/$defs/timestamp"
        }
      }
    },
    "agent_confirmation_required": {
      "description": "Agent → relay → controller. `challenge_text` is the PC's compact JSON serialisation of a `challenge` object, carried as an opaque string. The relay strict-parses a copy to validate it against #/$defs/challenge and forwards the ORIGINAL string verbatim; the controller strict-parses it once for display and hashes the string verbatim for confirmation.challenge_digest.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "command_id",
        "challenge_text"
      ],
      "properties": {
        "type": {
          "const": "confirmation_required"
        },
        "command_id": {
          "$ref": "#/$defs/uuid"
        },
        "challenge_text": {
          "type": "string",
          "minLength": 2,
          "maxLength": 4096
        }
      }
    },
    "challenge": {
      "description": "Issued by the PC and serialised ONCE into confirmation_required.challenge_text. `display.detail` and anything derived from window/tab titles is UNTRUSTED text: the controller renders the primary line from `action`/`params`/`target` using its own registry labels, shows the PC name from its own device inventory matched by `pc_id`, and renders `display.detail` as plain text in a secondary style. `action_label` is a hint only. The confirmation envelope must be signed by the same kid as the original command; the PC records that kid on the challenge.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "challenge_id",
        "command_id",
        "controller_id",
        "pc_id",
        "action",
        "params",
        "target",
        "target_state_digest",
        "issued_at",
        "expires_at",
        "display"
      ],
      "properties": {
        "challenge_id": {
          "$ref": "#/$defs/uuid"
        },
        "command_id": {
          "$ref": "#/$defs/uuid"
        },
        "controller_id": {
          "$ref": "#/$defs/uuid"
        },
        "pc_id": {
          "$ref": "#/$defs/uuid"
        },
        "action": {
          "type": "string"
        },
        "params": {
          "type": "object"
        },
        "target": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object"
            }
          ]
        },
        "target_state_digest": {
          "type": "string",
          "description": "base64url SHA-256 of the relevant target state (e.g., window title + handle) at challenge time; the PC re-checks before executing"
        },
        "issued_at": {
          "$ref": "#/$defs/timestamp"
        },
        "expires_at": {
          "$ref": "#/$defs/timestamp"
        },
        "display": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "pc_name",
            "action_label",
            "detail"
          ],
          "properties": {
            "pc_name": {
              "type": "string",
              "maxLength": 64
            },
            "action_label": {
              "type": "string",
              "maxLength": 80
            },
            "detail": {
              "type": "string",
              "maxLength": 200
            }
          }
        }
      }
    },
    "agent_result": {
      "description": "Terminal execution result. origin `agent` when produced by the PC, `relay` when the relay had to terminate the command itself (pre-forward rejection, PC offline, connection lost after forwarding → outcome_unknown).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "command_id",
        "origin",
        "state",
        "at",
        "duration_ms"
      ],
      "properties": {
        "type": {
          "const": "result"
        },
        "command_id": {
          "$ref": "#/$defs/uuid"
        },
        "origin": {
          "type": "string",
          "enum": [
            "agent",
            "relay"
          ]
        },
        "state": {
          "type": "string",
          "enum": [
            "succeeded",
            "failed",
            "expired",
            "canceled",
            "outcome_unknown"
          ]
        },
        "at": {
          "$ref": "#/$defs/timestamp"
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 0
        },
        "result": {
          "type": "object",
          "description": "Action-specific resulting state (e.g. new video id, volume)"
        },
        "error": {
          "$ref": "#/$defs/error"
        },
        "warning": {
          "type": "string",
          "maxLength": 256,
          "description": "e.g. 'A previous Next may have executed before the connection dropped'"
        }
      }
    },
    "agent_state": {
      "description": "Agent → relay → subscribed controllers. Periodic and on-change PC state. Media titles are untrusted display data.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "pc_id",
        "at",
        "state"
      ],
      "properties": {
        "type": {
          "const": "state"
        },
        "pc_id": {
          "$ref": "#/$defs/uuid"
        },
        "at": {
          "$ref": "#/$defs/timestamp"
        },
        "state": {
          "$ref": "#/$defs/pc_state"
        }
      }
    },
    "pc_state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "remote_enabled",
        "session_locked",
        "extension_connected"
      ],
      "properties": {
        "remote_enabled": {
          "type": "boolean"
        },
        "session_locked": {
          "type": "boolean"
        },
        "media_while_locked": {
          "type": "boolean"
        },
        "extension_connected": {
          "type": "boolean"
        },
        "platform": {
          "type": "string",
          "enum": [
            "windows",
            "development"
          ]
        },
        "volume": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "value": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "muted": {
              "type": "boolean"
            }
          }
        },
        "browser_instances": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "browser_instance_id",
              "browser"
            ],
            "properties": {
              "browser_instance_id": {
                "type": "string"
              },
              "browser": {
                "type": "string",
                "enum": [
                  "chrome",
                  "edge",
                  "unknown"
                ]
              },
              "profile_label": {
                "type": "string",
                "maxLength": 64
              }
            }
          }
        },
        "youtube_tabs": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/youtube_tab"
          }
        },
        "media_sessions": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/media_session"
          }
        },
        "pending_power_action": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "action",
                "command_id",
                "fires_at"
              ],
              "properties": {
                "action": {
                  "type": "string"
                },
                "command_id": {
                  "$ref": "#/$defs/uuid"
                },
                "fires_at": {
                  "$ref": "#/$defs/timestamp"
                }
              }
            }
          ]
        }
      }
    },
    "youtube_tab": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "browser_instance_id",
        "tab_id",
        "script_attached",
        "context",
        "ad_showing",
        "is_live",
        "in_playlist"
      ],
      "properties": {
        "browser_instance_id": {
          "type": "string"
        },
        "tab_id": {
          "type": "integer"
        },
        "tab_token": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{22}$",
          "description": "Present when script_attached; changes on every content-script attach"
        },
        "script_attached": {
          "type": "boolean",
          "description": "False means the tab exists but DoMe's content script is not running in it (reload needed); such a tab cannot be a target"
        },
        "title": {
          "type": "string",
          "maxLength": 200
        },
        "video_id": {
          "type": "string",
          "maxLength": 32
        },
        "paused": {
          "type": "boolean"
        },
        "muted": {
          "type": "boolean"
        },
        "volume": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "position_seconds": {
          "type": "number",
          "minimum": 0
        },
        "duration_seconds": {
          "type": "number",
          "minimum": 0
        },
        "context": {
          "type": "string",
          "enum": [
            "watch",
            "shorts",
            "music",
            "other"
          ],
          "description": "Page kind. Orthogonal flags below refine it."
        },
        "ad_showing": {
          "type": "boolean"
        },
        "is_live": {
          "type": "boolean"
        },
        "in_playlist": {
          "type": "boolean"
        },
        "theater": {
          "type": "boolean"
        },
        "fullscreen": {
          "type": "boolean"
        },
        "has_next": {
          "type": "boolean"
        },
        "has_previous": {
          "type": "boolean"
        },
        "active": {
          "type": "boolean"
        }
      }
    },
    "media_session": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "session_id",
        "status",
        "controls"
      ],
      "properties": {
        "session_id": {
          "type": "string"
        },
        "app_label": {
          "type": "string",
          "maxLength": 64
        },
        "title": {
          "type": "string",
          "maxLength": 200
        },
        "artist": {
          "type": "string",
          "maxLength": 200
        },
        "status": {
          "type": "string",
          "enum": [
            "playing",
            "paused",
            "stopped",
            "changing",
            "closed",
            "opened",
            "unknown"
          ]
        },
        "controls": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "play",
              "pause",
              "next",
              "previous"
            ]
          }
        }
      }
    },
    "pc_status_event": {
      "description": "Relay → controller. Connection-level status the relay knows (not execution state). `last_seen` is the last frame received from the PC.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "pc_id",
        "connection",
        "last_seen"
      ],
      "properties": {
        "type": {
          "const": "pc_status"
        },
        "pc_id": {
          "$ref": "#/$defs/uuid"
        },
        "connection": {
          "$ref": "#/$defs/pc_connection_state"
        },
        "last_seen": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/timestamp"
            }
          ]
        },
        "last_power_request": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "action",
                "at"
              ],
              "properties": {
                "action": {
                  "type": "string"
                },
                "at": {
                  "$ref": "#/$defs/timestamp"
                }
              }
            }
          ]
        },
        "enabled": {
          "type": "boolean",
          "description": "PC enabled on the account/plan"
        }
      }
    },
    "revoked": {
      "description": "Relay → controller when this controller's grant or session was revoked; the socket closes afterwards.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "reason"
      ],
      "properties": {
        "type": {
          "const": "revoked"
        },
        "pc_id": {
          "$ref": "#/$defs/uuid"
        },
        "reason": {
          "type": "string",
          "enum": [
            "controller_revoked",
            "grant_revoked",
            "session_ended",
            "account_deleted"
          ]
        }
      }
    },
    "ec_public_jwk": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kty",
        "crv",
        "x",
        "y"
      ],
      "properties": {
        "kty": {
          "const": "EC"
        },
        "crv": {
          "const": "P-256"
        },
        "x": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$"
        },
        "y": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$"
        }
      }
    },
    "controller_to_relay": {
      "oneOf": [
        {
          "$ref": "#/$defs/hello"
        },
        {
          "$ref": "#/$defs/controller_subscribe"
        },
        {
          "$ref": "#/$defs/controller_command"
        },
        {
          "$ref": "#/$defs/controller_confirmation"
        },
        {
          "$ref": "#/$defs/controller_cancel"
        },
        {
          "$ref": "#/$defs/ping"
        },
        {
          "$ref": "#/$defs/pong"
        }
      ]
    },
    "relay_to_controller": {
      "oneOf": [
        {
          "$ref": "#/$defs/hello_ack"
        },
        {
          "$ref": "#/$defs/error_frame"
        },
        {
          "$ref": "#/$defs/agent_ack"
        },
        {
          "$ref": "#/$defs/agent_confirmation_required"
        },
        {
          "$ref": "#/$defs/agent_result"
        },
        {
          "$ref": "#/$defs/agent_state"
        },
        {
          "$ref": "#/$defs/pc_status_event"
        },
        {
          "$ref": "#/$defs/revoked"
        },
        {
          "$ref": "#/$defs/ping"
        },
        {
          "$ref": "#/$defs/pong"
        }
      ]
    },
    "agent_to_relay": {
      "oneOf": [
        {
          "$ref": "#/$defs/hello"
        },
        {
          "$ref": "#/$defs/agent_ack"
        },
        {
          "$ref": "#/$defs/agent_confirmation_required"
        },
        {
          "$ref": "#/$defs/agent_result"
        },
        {
          "$ref": "#/$defs/agent_state"
        },
        {
          "$ref": "#/$defs/pairing_decision"
        },
        {
          "$ref": "#/$defs/error_frame"
        },
        {
          "$ref": "#/$defs/ping"
        },
        {
          "$ref": "#/$defs/pong"
        },
        {
          "$ref": "#/$defs/agent_revoke_controller"
        }
      ]
    },
    "relay_to_agent": {
      "oneOf": [
        {
          "$ref": "#/$defs/hello_ack"
        },
        {
          "$ref": "#/$defs/grants_snapshot"
        },
        {
          "$ref": "#/$defs/relay_to_agent_command"
        },
        {
          "$ref": "#/$defs/relay_to_agent_confirmation"
        },
        {
          "$ref": "#/$defs/relay_to_agent_cancel"
        },
        {
          "$ref": "#/$defs/pairing_request"
        },
        {
          "$ref": "#/$defs/error_frame"
        },
        {
          "$ref": "#/$defs/ping"
        },
        {
          "$ref": "#/$defs/pong"
        },
        {
          "$ref": "#/$defs/agent_revoked"
        }
      ]
    },
    "agent_revoke_controller": {
      "description": "Agent → relay. The PC owner revoked a controller locally (tray). The relay revokes the grant, sends `revoked` to that controller's sockets and a fresh grants_snapshot back.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "controller_id",
        "kid",
        "reason"
      ],
      "properties": {
        "type": {
          "const": "revoke_controller"
        },
        "controller_id": {
          "$ref": "#/$defs/uuid"
        },
        "kid": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$"
        },
        "reason": {
          "type": "string",
          "enum": [
            "local_revocation",
            "local_disable_all"
          ]
        }
      }
    },
    "agent_revoked": {
      "description": "Relay → agent. This PC's cloud access is gone. The agent must stop reconnecting, discard the PC credential, keep local grants for the user to inspect, and show a local re-link prompt.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "reason"
      ],
      "properties": {
        "type": {
          "const": "revoked"
        },
        "reason": {
          "type": "string",
          "enum": [
            "pc_unlinked",
            "pc_disabled_by_account",
            "account_deleted",
            "credential_rotated"
          ]
        }
      }
    },
    "hello_proof": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "protocol_version",
        "kid",
        "account_id",
        "issued_at",
        "expires_at",
        "nonce"
      ],
      "properties": {
        "type": {
          "const": "hello_proof"
        },
        "protocol_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+$"
        },
        "kid": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$"
        },
        "account_id": {
          "$ref": "#/$defs/uuid"
        },
        "issued_at": {
          "$ref": "#/$defs/timestamp"
        },
        "expires_at": {
          "$ref": "#/$defs/timestamp"
        },
        "nonce": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{22}$"
        }
      },
      "description": "Payload of hello.proof. Proves to the relay that the socket's owner holds the controller key before the socket is bound to the paired controller (a bare kid is public to the whole account). Verifier checks: signature with the JWK the relay stored at pairing for (session account, kid); envelope.kid == kid == hello.kid; account_id == the session's account; issued_at/expires_at within the normal window with lifetime <= confirmation_challenge_lifetime_seconds; nonce not seen before on this relay (single use)."
    }
  }
}
