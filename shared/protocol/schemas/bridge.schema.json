{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dome.app/schemas/bridge.schema.json",
  "title": "DoMe browser bridge frames (extension ⇄ native host ⇄ agent)",
  "description": "Chrome Native Messaging frames between the extension service worker and `dome-native-host`, and the identical JSON forwarded over the host's protected local IPC to the tray agent. Native messaging frames are limited to 1 MiB by Chrome; DoMe limits them to 64 KiB. The agent treats every field originating from a web page (titles, video ids) as untrusted display data. IPC identity rule (Windows): the agent and dome-native-host each derive the endpoint name from the SID of their OWN process token (GetTokenInformation TokenUser) and ProcessIdToSessionId(GetCurrentProcessId()); the agent creates the pipe with FILE_FLAG_FIRST_PIPE_INSTANCE | PIPE_REJECT_REMOTE_CLIENTS and a DACL granting only that SID, and on each connection verifies via GetNamedPipeClientProcessId that the client's session id and token SID equal its own before sending bridge_hello_ack; a mismatch is closed silently and logged as a local security event. Per-op result shapes: list_tabs → results.schema.json#/$defs/tabs_result; every other op → results.schema.json#/$defs/youtube_state_result (next/previous include previous_video_id).",
  "$defs": {
    "bridge_hello": {
      "description": "Extension → host → agent on port connect. `browser_instance_id` is a random id generated once per extension installation (chrome.storage.local) and identifies the browser profile.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "browser_instance_id",
        "browser",
        "extension_version",
        "protocol_versions"
      ],
      "properties": {
        "type": {
          "const": "bridge_hello"
        },
        "browser_instance_id": {
          "type": "string",
          "minLength": 8,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "browser": {
          "type": "string",
          "enum": [
            "chrome",
            "edge",
            "unknown"
          ]
        },
        "extension_version": {
          "type": "string",
          "maxLength": 32
        },
        "protocol_versions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+$"
          }
        },
        "profile_label": {
          "type": "string",
          "maxLength": 64
        }
      }
    },
    "bridge_hello_ack": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "protocol_version",
        "agent_version"
      ],
      "properties": {
        "type": {
          "const": "bridge_hello_ack"
        },
        "protocol_version": {
          "type": "string"
        },
        "agent_version": {
          "type": "string"
        }
      }
    },
    "bridge_request": {
      "description": "Agent → host → extension. `op` is a browser-adapter operation, not the public action name; the agent maps actions to ops. For tab ops the extension verifies tab_token matches the current attachment (else TARGET_CHANGED / TAB_NOT_CONTROLLABLE).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "request_id",
        "op",
        "args"
      ],
      "properties": {
        "type": {
          "const": "bridge_request"
        },
        "request_id": {
          "type": "string",
          "pattern": "^[0-9a-f-]{36}$"
        },
        "op": {
          "type": "string",
          "enum": [
            "list_tabs",
            "get_state",
            "set_paused",
            "next",
            "previous",
            "seek_relative",
            "seek_to",
            "set_muted",
            "set_volume",
            "set_theater",
            "request_fullscreen"
          ]
        },
        "args": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "tab_id": {
              "type": "integer",
              "minimum": 0
            },
            "tab_token": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{22}$"
            },
            "expected_video_id": {
              "type": "string",
              "maxLength": 32
            },
            "paused": {
              "type": "boolean"
            },
            "seconds": {
              "type": "integer"
            },
            "position_seconds": {
              "type": "number"
            },
            "muted": {
              "type": "boolean"
            },
            "value": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "enabled": {
              "type": "boolean"
            }
          }
        },
        "timeout_ms": {
          "type": "integer",
          "minimum": 100,
          "maximum": 60000
        }
      }
    },
    "bridge_response": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "request_id",
        "ok"
      ],
      "properties": {
        "type": {
          "const": "bridge_response"
        },
        "request_id": {
          "type": "string"
        },
        "ok": {
          "type": "boolean"
        },
        "result": {
          "oneOf": [
            {
              "$ref": "results.schema.json#/$defs/tabs_result"
            },
            {
              "$ref": "results.schema.json#/$defs/youtube_state_result"
            }
          ]
        },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "message"
          ],
          "properties": {
            "code": {
              "type": "string",
              "pattern": "^[A-Z_]+$"
            },
            "message": {
              "type": "string",
              "maxLength": 512
            }
          }
        }
      }
    },
    "bridge_event": {
      "description": "Extension → agent. `tabs_changed` is emitted on tab open/close/navigation AND on content-script attach/detach; `player_state` is debounced to at most 2 per second per tab.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "event",
        "at"
      ],
      "properties": {
        "type": {
          "const": "bridge_event"
        },
        "event": {
          "type": "string",
          "enum": [
            "tabs_changed",
            "player_state"
          ]
        },
        "at": {
          "type": "string"
        },
        "tabs": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "relay-frames.schema.json#/$defs/youtube_tab"
          }
        },
        "tab": {
          "$ref": "relay-frames.schema.json#/$defs/youtube_tab"
        }
      }
    },
    "extension_to_agent": {
      "oneOf": [
        {
          "$ref": "#/$defs/bridge_hello"
        },
        {
          "$ref": "#/$defs/bridge_response"
        },
        {
          "$ref": "#/$defs/bridge_event"
        },
        {
          "$ref": "#/$defs/bridge_error"
        }
      ]
    },
    "agent_to_extension": {
      "oneOf": [
        {
          "$ref": "#/$defs/bridge_hello_ack"
        },
        {
          "$ref": "#/$defs/bridge_request"
        },
        {
          "$ref": "#/$defs/bridge_error"
        }
      ]
    },
    "bridge_error": {
      "description": "Either direction. Protocol incompatibility on hello (carries both version lists in detail) or a request that could not be processed at all. Request-scoped failures use bridge_response{ok:false}.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "error"
      ],
      "properties": {
        "type": {
          "const": "bridge_error"
        },
        "ref_request_id": {
          "type": "string"
        },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "message"
          ],
          "properties": {
            "code": {
              "type": "string",
              "pattern": "^[A-Z_]+$"
            },
            "message": {
              "type": "string",
              "maxLength": 512
            },
            "detail": {
              "type": "object"
            }
          }
        }
      }
    }
  }
}
