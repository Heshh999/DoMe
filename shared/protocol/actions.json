      "target": null,
      "result": "ping_result",
      "capability": "status",
      "risk": "low",
      "confirmation": "none",
      "timeout_ms": 5000,
      "availability": [],
      "verification": "response",
      "idempotent": true,
      "routine_allowed": false
    },
