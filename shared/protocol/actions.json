{
  "$comment": "DoMe action registry v1.0. Every action declares: params (JSON Schema, additionalProperties always false), target (name in target_schemas or null), result (name of a $def in schemas/results.schema.json; the agent validates before emitting, the controller before rendering), capability (grant scope the controller must hold), risk (low|moderate|disruptive), confirmation (none|challenge), timeout_ms, availability (conditions the PC checks before executing), verification (how success is established), coalesce (optional: the coalescing GROUP is (coalesce key, canonical target JSON or '' when null) per PC across all controllers; a later command in the same group replaces queued earlier ones, which terminate as canceled/COMMAND_SUPERSEDED), routine_allowed (may appear in Pro routines), idempotent (safe to re-emit the previous result for an identical duplicate; non-idempotent actions are never auto-retried). youtube_target requires tab_token so a command can never silently re-bind to a different tab (tab ids are reused across browser restarts).",
  "registry_version": "1.0",
  "capabilities": {
    "status": "Read PC, media and browser state.",
    "media": "Control YouTube and Windows media sessions.",
    "volume": "Change Windows system volume and mute.",
    "apps": "Launch, focus, minimise and close approved applications.",
    "lock": "Lock the Windows session.",
    "power": "Sleep, restart or shut down the PC (always confirmed)."
  },
  "target_schemas": {
    "youtube_target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "browser_instance_id",
        "tab_id",
        "tab_token"
      ],
      "properties": {
        "browser_instance_id": {
          "type": "string",
          "minLength": 8,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "tab_id": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "tab_token": {
          "type": "string",
          "minLength": 22,
          "maxLength": 22,
          "pattern": "^[A-Za-z0-9_-]{22}$",
          "description": "Random token generated by the content script each time it attaches to a tab (reported in youtube_tab). Binds the command to one attachment so a reused Chrome tab id after a browser restart cannot be re-targeted."
        },
        "expected_video_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^[A-Za-z0-9_-]+$"
        }
      }
    },
    "media_session_target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "session_id"
      ],
      "properties": {
        "session_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "window_target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "app_id"
      ],
      "properties": {
        "app_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z0-9][a-z0-9_-]*$"
        },
        "window_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9_-]+$"
        }
      }
    }
  },
