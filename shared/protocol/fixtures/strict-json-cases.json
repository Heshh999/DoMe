{
  "$comment": "Shared accept/reject decisions for the strict JSON parsers and schema pattern matching. Both shared/python and shared/ts run every case. `expect` is 'accept' or an error code.",
  "parser_cases": [
    {
      "name": "plain object",
      "text": "{\"a\":1,\"b\":[true,null,\"x\"]}",
      "expect": "accept"
    },
    {
      "name": "unicode preserved",
      "text": "{\"s\":\"ü→😀\"}",
      "expect": "accept"
    },
    {
      "name": "escaped surrogate pair",
      "text": "{\"s\":\"\\ud83d\\ude00\"}",
      "expect": "accept"
    },
    {
      "name": "depth 8 ok",
      "text": "{\"a\":{\"a\":{\"a\":{\"a\":{\"a\":{\"a\":{\"a\":{\"a\":1}}}}}}}}",
      "expect": "accept"
    },
    {
      "name": "max safe integer",
      "text": "{\"n\":9007199254740991}",
      "expect": "accept"
    },
    {
      "name": "negative float",
      "text": "{\"n\":-12.5e3}",
      "expect": "accept"
    },
    {
      "name": "duplicate key",
      "text": "{\"a\":1,\"a\":2}",
      "expect": "MALFORMED_MESSAGE"
    },
    {
      "name": "nested duplicate key",
      "text": "{\"a\":{\"b\":1,\"b\":2}}",
      "expect": "MALFORMED_MESSAGE"
    },
    {
      "name": "NaN",
      "text": "{\"a\":NaN}",
      "expect": "MALFORMED_MESSAGE"
    },
    {
      "name": "Infinity",
      "text": "{\"a\":Infinity}",
      "expect": "MALFORMED_MESSAGE"
    },
    {
      "name": "overflow exponent",
      "text": "{\"a\":1e999}",
      "expect": "MALFORMED_MESSAGE"
    },
    {
      "name": "unsafe integer",
      "text": "{\"n\":9007199254740993}",
      "expect": "MALFORMED_MESSAGE"
    },
    {
      "name": "negative unsafe integer",
      "text": "{\"n\":-9007199254740993}",
      "expect": "MALFORMED_MESSAGE"
    },
    {
      "name": "huge integer literal",
      "text": "{\"n\":123456789012345678901234567890}",
      "expect": "MALFORMED_MESSAGE"
    },
    {
      "name": "depth 9 too deep",
      "text": "{\"a\":{\"a\":{\"a\":{\"a\":{\"a\":{\"a\":{\"a\":{\"a\":{\"a\":1}}}}}}}}}",
      "expect": "MALFORMED_MESSAGE"
    },
    {
      "name": "array top level",
      "text": "[1,2]",
      "expect": "MALFORMED_MESSAGE"
    },
    {
      "name": "string top level",
      "text": "\"x\"",
      "expect": "MALFORMED_MESSAGE"
    },
    {
      "name": "lone high surrogate",
      "text": "{\"s\":\"\\ud800\"}",
      "expect": "MALFORMED_MESSAGE"
    },
    {
      "name": "lone low surrogate",
      "text": "{\"s\":\"\\udc00\"}",
      "expect": "MALFORMED_MESSAGE"
    },
    {
      "name": "__proto__ key",
      "text": "{\"__proto__\":{\"x\":1}}",
      "expect": "MALFORMED_MESSAGE"
    },
    {
      "name": "constructor key",
      "text": "{\"constructor\":1}",
      "expect": "MALFORMED_MESSAGE"
    },
    {
      "name": "prototype key nested",
      "text": "{\"a\":{\"prototype\":1}}",
      "expect": "MALFORMED_MESSAGE"
    },
    {
      "name": "trailing comma",
      "text": "{\"a\":1,}",
      "expect": "MALFORMED_MESSAGE"
    },
    {
      "name": "trailing garbage",
      "text": "{\"a\":1} x",
      "expect": "MALFORMED_MESSAGE"
    },
    {
      "name": "raw control char",
      "text": "{\"a\":\"x\u0001\"}",
      "expect": "MALFORMED_MESSAGE"
    },
    {
      "name": "bad escape",
      "text": "{\"a\":\"\\x\"}",
      "expect": "MALFORMED_MESSAGE"
    },
    {
      "name": "single quotes",
      "text": "{'a':1}",
      "expect": "MALFORMED_MESSAGE"
    },
    {
      "name": "leading zeros",
      "text": "{\"a\":01}",
      "expect": "MALFORMED_MESSAGE"
    },
    {
      "name": "empty",
      "text": "",
      "expect": "MALFORMED_MESSAGE"
    }
  ],
  "pattern_cases": [
    {
      "pattern": "^[a-z0-9][a-z0-9_-]*$",
      "value": "discord",
      "expect": true
    },
    {
      "pattern": "^[a-z0-9][a-z0-9_-]*$",
      "value": "discord\n",
      "expect": false
    },
    {
      "pattern": "^[a-z0-9][a-z0-9_-]*$",
      "value": "Discord",
      "expect": false
    },
    {
      "pattern": "^[a-z0-9][a-z0-9_-]*$",
      "value": "chrome; rm -rf /",
      "expect": false
    },
    {
      "pattern": "^[0-9]+\\.[0-9]+$",
      "value": "1.0",
      "expect": true
    },
    {
      "pattern": "^[0-9]+\\.[0-9]+$",
      "value": "1.0\n",
      "expect": false
    },
    {
      "pattern": "^[0-9]+\\.[0-9]+$",
      "value": "１.０",
      "expect": false
    },
    {
      "pattern": "^\\d+$",
      "value": "１２",
      "expect": false
    },
    {
      "pattern": "^\\d+$",
      "value": "12",
      "expect": true
    },
    {
      "pattern": "^[A-Za-z0-9_-]{22}$",
      "value": "AAAAAAAAAAAAAAAAAAAAAA",
      "expect": true
    },
    {
      "pattern": "^[A-Za-z0-9_-]{22}$",
      "value": "AAAAAAAAAAAAAAAAAAAAAA\n",
      "expect": false
    },
    {
      "pattern": "^[A-Za-z0-9_-]{22}$",
      "value": "AAAAAAAAAAAAAAAAAAAAA",
      "expect": false
    },
    {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,3})?Z$",
      "value": "2026-10-08T12:00:00.000Z",
      "expect": true
    },
    {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,3})?Z$",
      "value": "2026-10-08T12:00:00.000Z\n",
      "expect": false
    },
    {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,3})?Z$",
      "value": "2026-10-08T12:00:00+00:00",
      "expect": false
    }
  ],
  "timestamp_cases": [
    {
      "value": "2026-10-08T12:00:00.000Z",
      "expect": "accept"
    },
    {
      "value": "2026-10-08T12:00:00Z",
      "expect": "accept"
    },
    {
      "value": "2026-10-08T12:00:00.5Z",
      "expect": "accept"
    },
    {
      "value": "2026-02-30T00:00:00.000Z",
      "expect": "MALFORMED_MESSAGE"
    },
    {
      "value": "2026-04-31T00:00:00.000Z",
      "expect": "MALFORMED_MESSAGE"
    },
    {
      "value": "2026-10-08T24:00:00.000Z",
      "expect": "MALFORMED_MESSAGE"
    },
    {
      "value": "2026-10-08T12:60:00.000Z",
      "expect": "MALFORMED_MESSAGE"
    },
    {
      "value": "2026-13-01T00:00:00.000Z",
      "expect": "MALFORMED_MESSAGE"
    },
    {
      "value": "2026-10-08T12:00:00.000Z\n",
      "expect": "MALFORMED_MESSAGE"
    },
    {
      "value": "2026-10-08T12:00:00.000+00:00",
      "expect": "MALFORMED_MESSAGE"
    },
    {
      "value": "2026-10-08 12:00:00Z",
      "expect": "MALFORMED_MESSAGE"
    },
    {
      "value": "２０２６-10-08T12:00:00.000Z",
      "expect": "MALFORMED_MESSAGE"
    }
  ]
}
