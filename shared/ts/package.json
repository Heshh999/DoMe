{
  "name": "@dome/protocol",
  "version": "1.0.0",
  "private": true,
  "description": "DoMe shared protocol library (TypeScript): strict JSON, ES256 envelopes via WebCrypto, action registry and frame validation",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "files": ["src"],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "gen:types": "tsx scripts/gen-types.ts",
    "fixtures": "tsx scripts/make-fixtures.ts"
  },
  "dependencies": {
    "ajv": "8.20.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "json-schema-to-typescript": "15.0.4",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
