# DoMe environment template. Copy to .env for local development. Never commit real values.
# Every variable is read by exactly one component, named in the comment.

############ cloud-api ############
DOME_ENV=development                      # development | staging | production
DOME_PUBLIC_ORIGIN=http://localhost:5173  # exact origin the PWA is served from (Origin checks, cookies, QR links)
DOME_API_BIND=127.0.0.1:8000
DOME_DATABASE_URL=postgresql+psycopg://dome@localhost:54329/dome_dev
DOME_SESSION_SECRET=change-me-32-bytes-base64url   # signs session cookie ids; rotate via docs/OPERATIONS.md
DOME_SESSION_IDLE_DAYS=30

# OpenID Connect relying-party settings (ADR-0001 D3). Development uses tools/dev-idp.
DOME_OIDC_ISSUER=http://127.0.0.1:8081
DOME_OIDC_CLIENT_ID=dome-dev
DOME_OIDC_CLIENT_SECRET=dome-dev-secret
DOME_OIDC_REDIRECT_PATH=/v1/auth/callback
DOME_OIDC_SCOPES=openid email profile

# Entitlement assertion signing key (EdDSA, PEM, PKCS8). Generate: make gen-entitlement-key
DOME_ENTITLEMENT_SIGNING_KEY_PEM_PATH=./cloud-api/.dome-dev-state/entitlement-ed25519.pem

# Relay limits
DOME_RELAY_MAX_CONNECTIONS=5000
DOME_RELAY_MAX_FRAME_BYTES=65536
DOME_RELAY_PER_PC_QUEUE_DEPTH=16

# Stripe (test mode only until founder enables live). Leave blank to disable billing endpoints.
DOME_STRIPE_SECRET_KEY=
DOME_STRIPE_WEBHOOK_SECRET=
DOME_STRIPE_PRICE_MONTHLY=
DOME_STRIPE_PRICE_ANNUAL=

# Optional AI provider (Phase E; disabled by default)
DOME_AI_ENABLED=false
DOME_AI_PROVIDER=
DOME_AI_API_KEY=

############ tools/dev-idp (development only) ############
DEV_IDP_BIND=127.0.0.1:8081
DEV_IDP_ISSUER=http://127.0.0.1:8081
DEV_IDP_CLIENT_ID=dome-dev
DEV_IDP_CLIENT_SECRET=dome-dev-secret
DEV_IDP_REDIRECT_URI=http://localhost:5173/v1/auth/callback

############ pc-agent ############
DOME_AGENT_RELAY_URL=ws://127.0.0.1:8000/ws/agent
DOME_AGENT_API_URL=http://127.0.0.1:8000
DOME_AGENT_STATE_DIR=                     # default: %LOCALAPPDATA%\DoMe on Windows, ~/.local/state/dome elsewhere
DOME_AGENT_LOG_LEVEL=INFO

############ mobile-app (Vite, build-time, public) ############
VITE_DOME_API_ORIGIN=                     # empty = same origin
VITE_DOME_RELEASE_CHANNEL=dev
