# DoMe environment template. Copy to .env for local development. Never commit real values.
# Every variable is read by exactly one component, named in the comment.

############ cloud-api ############
DOME_ENV=development                      # development | staging | production
DOME_PUBLIC_ORIGIN=http://localhost:5173  # exact origin the PWA is served from (Origin checks, cookies, QR links)
DOME_API_BIND=127.0.0.1:8000
# Client addresses behind a reverse proxy (cloud-api/README.md "Client addresses behind a proxy"). Empty in
# development: the TCP peer is the client. Required in staging/production; the Fly.io values live in deploy/fly.toml.
DOME_TRUSTED_PROXIES=
# DOME_CLIENT_IP_HEADER: empty, or fly-client-ip (only read from a trusted proxy)
DOME_CLIENT_IP_HEADER=
# DOME_BUILD_COMMIT is set by the container image (deploy/Dockerfile build argument); leave it unset locally.
DOME_DATABASE_URL=postgresql+psycopg://dome@localhost:54329/dome_dev
DOME_SESSION_SECRET=change-me-32-bytes-base64url   # signs session cookie ids; rotate via docs/OPERATIONS.md
DOME_SESSION_IDLE_DAYS=30

# OpenID Connect relying-party settings (ADR-0001 D3). Development uses tools/dev-idp.
DOME_OIDC_ISSUER=http://127.0.0.1:8081
DOME_OIDC_CLIENT_ID=dome-dev
DOME_OIDC_CLIENT_SECRET=dome-dev-secret
DOME_OIDC_REDIRECT_PATH=/v1/auth/callback
DOME_OIDC_SCOPES=openid email profile

# Entitlement assertion signing key (EdDSA, PEM, PKCS8). Generate: make gen-entitlement-key
DOME_ENTITLEMENT_SIGNING_KEY_PEM_PATH=./cloud-api/.dome-dev-state/entitlement-ed25519.pem

# Relay limits
DOME_RELAY_MAX_CONNECTIONS=5000
DOME_RELAY_MAX_FRAME_BYTES=65536
DOME_RELAY_PER_PC_QUEUE_DEPTH=16

# Stripe billing (docs/BILLING.md, docs/LAUNCH_SETUP.md "Stripe (payments)"). Leave all seven blank and billing is
# off: nothing can be bought. Set all seven or none (a partial set refuses start-up). Outside production only a test
# key (sk_test_ / rk_test_) is accepted. Never commit real values. Staging and production get these from their GitHub
# Environment through the Deploy button (deploy/README.md "Billing (Stripe) through the Deploy button").
DOME_STRIPE_SECRET_KEY=
DOME_STRIPE_WEBHOOK_SECRET=
DOME_STRIPE_PRICE_PRO_MONTHLY=
DOME_STRIPE_PRICE_PRO_ANNUAL=
DOME_STRIPE_PRICE_PRO_PLUS_MONTHLY=
DOME_STRIPE_PRICE_PRO_PLUS_ANNUAL=
DOME_STRIPE_PRICE_TOPUP=
# blank = stripe when a key is set; fake = in-memory stand-in (development/test only)
DOME_BILLING_PROVIDER=
# the Stripe prices are tax-inclusive (founder decision); keep Stripe Tax off unless that decision is revisited
DOME_STRIPE_AUTOMATIC_TAX=false

# Optional AI assistant (Phase E; disabled by default; docs/design/assistant.md, cloud-api/README.md)
DOME_AI_ENABLED=false
# anthropic, or fake (scripted test provider; development/test only)
DOME_AI_PROVIDER=
# server only, never on the phone or the PC (renamed from DOME_AI_API_KEY)
DOME_AI_ANTHROPIC_API_KEY=
# operator spending ceiling per calendar month, US cents; must be above 0 when the assistant is on
DOME_AI_MONTHLY_CEILING_CENTS=0
# development/test allowance (plans.json allowances are 0 until the Phase E gate); refused in staging/production
DOME_AI_DEV_GRANT_INTERPRETATIONS=0
DOME_AI_DEV_GRANT_COST_CAP_CENTS=0

# Screen view, Phase 1 beta (protocol 1.4; docs/design/screen-view.md §12, §13, §20; cloud-api/README.md "Screen view").
# Off by default: the switch refuses every start with SCREEN_VIEW_DISABLED until the launch gate. The relay server for
# the phone (Cloudflare Realtime TURN) needs DOME_TURN_KEY_ID and DOME_TURN_API_TOKEN together, both or neither (a half
# set refuses start-up); without them Screen view works only where a direct connection exists (`turn: unavailable`).
# DOME_TURN_ANALYTICS_TOKEN (read-only analytics scope, hourly usage reconciliation) is optional and only with them.
# Never commit real values. Staging and production get these from their GitHub Environment through the Deploy button.
DOME_SCREEN_VIEW_ENABLED=false
DOME_TURN_KEY_ID=
DOME_TURN_API_TOKEN=
DOME_TURN_ANALYTICS_TOKEN=
# blank = cloudflare when the two TURN values are set, else none (STUN only); fake = in-memory stand-in (development/test)
DOME_TURN_PROVIDER=
# the graduated monthly guard on the provider's figures (GB): Data saver for relayed Free sessions past the soft cap,
# STUN only for Free past the hard cap; per-account caps: relayed GB per day on Free, credentials minted per month
DOME_SCREEN_TURN_SOFT_CAP_GB=700
DOME_SCREEN_TURN_HARD_CAP_GB=900
DOME_SCREEN_TURN_FREE_DAILY_GB=2
DOME_SCREEN_TURN_MINTS_PER_ACCOUNT_MONTH=600
# STUN servers handed to both devices (free, no key); comma-separated stun:/stuns: urls, never turn:
DOME_SCREEN_STUN_URLS=stun:stun.cloudflare.com:3478
# a shorter Free allowance for testing (seconds per 5-hour window); 0 = plans.json (600); refused in production
DOME_SCREEN_FREE_SECONDS_OVERRIDE=0

############ tools/dev-idp (development only) ############
DEV_IDP_BIND=127.0.0.1:8081
DEV_IDP_ISSUER=http://127.0.0.1:8081
DEV_IDP_CLIENT_ID=dome-dev
DEV_IDP_CLIENT_SECRET=dome-dev-secret
DEV_IDP_REDIRECT_URI=http://localhost:5173/v1/auth/callback

############ pc-agent ############
DOME_AGENT_RELAY_URL=ws://127.0.0.1:8000/ws/agent
DOME_AGENT_API_URL=http://127.0.0.1:8000
DOME_AGENT_STATE_DIR=                     # default: %LOCALAPPDATA%\DoMe on Windows, ~/.local/state/dome elsewhere
DOME_AGENT_LOG_LEVEL=INFO

############ mobile-app (Vite, build-time, public) ############
VITE_DOME_API_ORIGIN=                     # empty = same origin
VITE_DOME_RELEASE_CHANNEL=dev
