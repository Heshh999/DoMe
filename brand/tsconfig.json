{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "types": ["node"],
    "typeRoots": ["../mobile-app/node_modules/@types"],
    "skipLibCheck": true
  },
  "include": ["scripts/**/*.mjs", "tests/**/*.mjs"]
}
